{
  "name": "weakword-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive typing practice layered on top of monkeytype.com",
  "main": "dist/main/main.js",
  "author": "Weakword Coach contributors",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --win nsis",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "build": {
    "appId": "com.weakwordcoach.app",
    "productName": "Weakword Coach",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/better-sqlite3/{deps,src,binding.gyp,README.md}",
      "!node_modules/better-sqlite3/prebuilds/!(win32-x64.node)",
      "!node_modules/better-sqlite3/lib/{darwin,linux,linuxmusl}-*.js",
      "!node_modules/node-addon-api",
      "!node_modules/@fontsource-variable"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Weakword-Coach-Setup-${version}.${ext}"
    },
    "copyright": "Copyright © 2026 Weakword Coach contributors",
    "electronLanguages": [
      "en-US"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "better-sqlite3": false
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "better-sqlite3": "^13.2.0"
  }
}
